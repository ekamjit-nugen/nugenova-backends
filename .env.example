# ── Postgres (Supabase) — the ONLY datastore for this repo ───────────────────
# Session pooler (port 5432, user postgres.<ref>) for both app and migrations.
# Grab it from Supabase → Project Settings → Database → "Session pooler".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Per-process Postgres pool. Supabase's session pooler caps ALL clients for the project (e.g. 15),
# shared by every instance, deploy overlap and scripts — keep this small. Transaction pooler (:6543) gives more headroom.
DB_POOL_MAX=5
# DB_POOL_IDLE_MS=10000
# DB_CONNECT_TIMEOUT_MS=15000
# Background candidate imports: set to 'off' on instances that must not run the worker.
# RECRUITMENT_IMPORT_WORKER=on
# RECRUITMENT_IMPORT_POLL_MS=5000

# ── Mongo (READ-ONLY, ETL source only) ───────────────────────────────────────
# Points at the legacy monolith's Mongo cluster so ETL scripts can copy data in.
# Not used by the running app.
MONGODB_URI=mongodb://localhost:27017/nugenova

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# Dev OTP bypass: any user can log in with DEV_OTP_CODE when true + non-prod.
DEV_OTP_BYPASS=true
DEV_OTP_CODE=000000

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
BODY_LIMIT=10mb
CORS_ORIGINS=http://localhost:3000
