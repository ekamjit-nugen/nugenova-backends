# ── Postgres (Supabase) — the ONLY datastore for this repo ───────────────────
# Session pooler (port 5432, user postgres.<ref>) for both app and migrations.
# Grab it from Supabase → Project Settings → Database → "Session pooler".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Mongo (READ-ONLY, ETL source only) ───────────────────────────────────────
# Points at the legacy monolith's Mongo cluster so ETL scripts can copy data in.
# Not used by the running app.
MONGODB_URI=mongodb://localhost:27017/nugenova

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# Dev OTP bypass: any user can log in with DEV_OTP_CODE when true + non-prod.
DEV_OTP_BYPASS=true
DEV_OTP_CODE=000000

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
BODY_LIMIT=10mb
CORS_ORIGINS=http://localhost:3000
