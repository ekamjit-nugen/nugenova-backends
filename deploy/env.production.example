# Production env for the Nugenova API — copy to /var/www/nugenova-api/.env on the
# server and fill in the real values. NEVER commit the filled file (.env* is
# gitignored). The app loads this via dotenv at boot (src/main.ts).

# ── Postgres (Supabase) ───────────────────────────────────────────────────────
# Session pooler (port 5432) — used by the running app.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection (port 5432, host db.<ref>.supabase.co) — used by migrations.
# Optional but recommended; migrations fall back to DATABASE_URL if unset.
DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1          # bind to loopback; only nginx reaches the app
PORT=4000
BODY_LIMIT=30mb

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate-a-long-random-string>   # e.g. `openssl rand -base64 48`
# MUST be false in production — otherwise 000000 logs anyone in.
DEV_OTP_BYPASS=false

# ── CORS + links ──────────────────────────────────────────────────────────────
# Comma-separated allowed browser origins (your production frontend).
CORS_ORIGINS=https://app.nugenova.com
# Base URL used in onboarding email links (Submit documents, etc.).
FRONTEND_URL=https://app.nugenova.com

# ── Mail (ZeptoMail — real delivery) ──────────────────────────────────────────
MAIL_DRIVER=zeptomail
MAIL_FROM=noreply@nugenova.com
MAIL_FROM_NAME=Nugenova
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=<zeptomail-send-token>
ZEPTOMAIL_FROM=noreply@nugenova.com
ZEPTOMAIL_FROM_NAME=Nugenova

# ── File storage (optional) ───────────────────────────────────────────────────
# Leave S3_* unset to store uploaded files in Postgres (bytea). Set them to use
# real S3 (recommended for production scale):
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET=s3-nugenova
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # leave blank for real AWS S3
