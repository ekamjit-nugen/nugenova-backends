# Production env for the Nugenova API — copy to /var/www/nugenova-api/.env on the
# server and fill in the real values. NEVER commit the filled file (.env* is
# gitignored). The app loads this via dotenv at boot (src/main.ts).

# ── Postgres (Supabase) ───────────────────────────────────────────────────────
# Session pooler (port 5432) — used by the running app.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection (port 5432, host db.<ref>.supabase.co) — used by migrations.
# Optional but recommended; migrations fall back to DATABASE_URL if unset.
DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1          # bind to loopback; only nginx reaches the app
PORT=4100               # must be free on the box (4000 is taken on the E2E box); nginx proxies to this
BODY_LIMIT=30mb

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate-a-long-random-string>   # e.g. `openssl rand -base64 48`
# Access-token TTL (refresh token + session are 7d). Default 6h — matches the
# legacy Nugenova app. Override only if you need a different session length.
JWT_EXPIRY=6h
# OTP throttling — defaults match the legacy app; shown here for visibility.
OTP_MAX_ATTEMPTS=5            # verify attempts before lockout
OTP_LOCKOUT_MINUTES=30        # lockout duration after too many attempts
OTP_RATE_LIMIT_PER_HOUR=20   # send-OTP requests allowed per email per hour
OTP_RESEND_COOLDOWN_SECONDS=30
# MUST be false in production — otherwise 000000 logs anyone in.
DEV_OTP_BYPASS=false

# ── CORS + links ──────────────────────────────────────────────────────────────
# Comma-separated allowed browser origins (your production frontend).
CORS_ORIGINS=https://app.nugenova.com
# Base URL used in onboarding email links (Submit documents, etc.).
FRONTEND_URL=https://app.nugenova.com

# ── Mail (ZeptoMail — real delivery) ──────────────────────────────────────────
MAIL_DRIVER=zeptomail
MAIL_FROM=noreply@nugenova.com
MAIL_FROM_NAME=Nugenova
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=<zeptomail-send-token>
ZEPTOMAIL_FROM=noreply@nugenova.com
ZEPTOMAIL_FROM_NAME=Nugenova

# ── File storage (optional) ───────────────────────────────────────────────────
# Leave S3_* unset to store uploaded files in Postgres (bytea). Set them to use
# real S3 (recommended for production scale):
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET=s3-nugenova
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # leave blank for real AWS S3

# ── Real-time push (Firebase Cloud Messaging, Web Push) ──
# Service account (Firebase console → Project settings → Service accounts → Generate key).
# FCM_PRIVATE_KEY: the full PEM on one line with \n escapes, wrapped in double quotes.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Web app config (Project settings → General → Your apps → Web app) — public values.
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_MESSAGING_SENDER_ID=
# Web Push certificate key pair (Project settings → Cloud Messaging → Web configuration) — public key.
VAPID_PUBLIC_KEY=

# ── Error alerts ────────────────────────────────────────────────────────────
# Every failed request is written to the activity log; a 5xx also emails the
# complete reason (message, stack, route, user) to these addresses AND to the
# org owner. Comma-separated. Leave blank to email only the owner.
ERROR_ALERT_EMAIL=
# Minutes to wait before alerting again about the same route + message, so one
# broken endpoint under load sends a single mail. 0 alerts on every failure.
ERROR_ALERT_THROTTLE_MIN=15

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Leave unset (or true) in production: the @Cron jobs (attendance absent marking
# and reminders, daily summary, onboarding reminders, retention) run here.
# Set to false on any OTHER machine pointing at a shared database, or those jobs
# run against it a second time.
# ENABLE_SCHEDULED_JOBS=true
